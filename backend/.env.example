# Server Configuration
PORT=5000
NODE_ENV=development

# Client URL (CORS configuration)
CLIENT_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agentscout?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Bright Data Integration Configuration (Scraper Studio Collector DCA API)
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_COLLECTOR_ID=
BRIGHT_DATA_BASE_URL=https://api.brightdata.com

# Google Gemini AI Integration Configuration
GEMINI_API_KEY=
