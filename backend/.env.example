# Server Configuration
PORT=5001
NODE_ENV=development

# Client & Backend URLs (CORS & OAuth callbacks)
CLIENT_URL=http://localhost:5173
BACKEND_URL=http://localhost:5001

# Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agentscout?retryWrites=true&w=majority

# JWT Authentication Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Bright Data Integration Configuration
BRIGHT_DATA_API_KEY=
BRIGHT_DATA_COLLECTOR_ID=
BRIGHT_DATA_BASE_URL=https://api.brightdata.com

# Google Gemini AI Integration Configuration
GEMINI_API_KEY=

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/auth/google/callback

# GitHub OAuth Credentials
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5001/api/auth/github/callback

# LinkedIn OAuth 2.0 Credentials (OpenID Connect)
LINKEDIN_CLIENT_ID=your_linkedin_client_id
LINKEDIN_CLIENT_SECRET=your_linkedin_client_secret
LINKEDIN_CALLBACK_URL=http://localhost:5001/api/auth/linkedin/callback
