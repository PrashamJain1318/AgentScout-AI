# AgentScout AI Environment Variables Template
# Copy this file to backend/.env and frontend/.env respectively.

# BACKEND CONFIGURATION (backend/.env)
PORT=5001
NODE_ENV=development
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/agentscout?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d
COOKIE_EXPIRES_DAYS=7

# Bright Data API Configuration
BRIGHT_DATA_API_KEY=your_bright_data_api_key
BRIGHT_DATA_COLLECTOR_ID=your_bright_data_collector_id
BRIGHT_DATA_BASE_URL=https://api.brightdata.com

# Google Gemini AI Configuration
GEMINI_API_KEY=your_gemini_api_key

# FRONTEND CONFIGURATION (frontend/.env)
VITE_API_BASE_URL=/api
